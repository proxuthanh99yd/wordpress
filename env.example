# WordPress Database Configuration
MYSQL_ROOT_PASSWORD=icanfield123
MYSQL_DATABASE=icanfield123_db
MYSQL_USER=icanfield123_user
MYSQL_PASSWORD=icanfield123_pass

# WordPress Table Prefix
