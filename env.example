# WordPress Database Configuration
# Đổi toàn bộ giá trị bên dưới trước khi `docker-compose up` lần đầu (dùng mật khẩu mạnh, ngẫu nhiên).
MYSQL_ROOT_PASSWORD=change_me_root_password
MYSQL_DATABASE=foodinno_db
MYSQL_USER=foodinno_user
MYSQL_PASSWORD=change_me_db_password

# WordPress Table Prefix
WORDPRESS_TABLE_PREFIX=foodinno_

# WordPress salts/keys — BẮT BUỘC sinh giá trị ngẫu nhiên (chạy ./setup.sh,
# hoặc lấy từ https://api.wordpress.org/secret-key/1.1/salt/)
WORDPRESS_AUTH_KEY=change_me_random_64_chars
WORDPRESS_SECURE_AUTH_KEY=change_me_random_64_chars
WORDPRESS_LOGGED_IN_KEY=change_me_random_64_chars
WORDPRESS_NONCE_KEY=change_me_random_64_chars
WORDPRESS_AUTH_SALT=change_me_random_64_chars
WORDPRESS_SECURE_AUTH_SALT=change_me_random_64_chars
WORDPRESS_LOGGED_IN_SALT=change_me_random_64_chars
WORDPRESS_NONCE_SALT=change_me_random_64_chars

# Headless CMS — public site URL (dùng cho WP_HOME/WP_SITEURL, sau reverse proxy HTTPS)
WP_SITE_URL=https://cms.food.innojsc.com

# Headless CMS — origin của frontend Next.js (dùng cho CORS, KHÔNG để trống/`*`)
FRONTEND_ORIGIN=https://food.innojsc.com

